# App
APP_NAME=OpsPilot
ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database (Neon Postgres in production)
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot

# Redis (Upstash in production)
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Uploads
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/tmp/opspilot_uploads

# Rate limit
RATE_LIMIT=100/minute
